{
  "$defs": {
    "EntityTrack": {
      "additionalProperties": false,
      "description": "One entity's samples. ``xy`` is flat integer decimeters [x0, y0, x1, y1, ...]; ``act`` indexes meta.activities.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "xy": {
          "items": {
            "type": "integer"
          },
          "title": "Xy",
          "type": "array"
        },
        "act": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Act"
        }
      },
      "required": [
        "id",
        "xy"
      ],
      "title": "EntityTrack",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "hz": {
      "const": 1,
      "default": 1,
      "title": "Hz",
      "type": "integer"
    },
    "unit": {
      "const": "dm",
      "default": "dm",
      "title": "Unit",
      "type": "string"
    },
    "seconds": {
      "minimum": 1,
      "title": "Seconds",
      "type": "integer"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/EntityTrack"
      },
      "maxItems": 24,
      "minItems": 24,
      "title": "Entities",
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "seconds",
    "entities"
  ],
  "title": "PositionsFile",
  "type": "object"
}
