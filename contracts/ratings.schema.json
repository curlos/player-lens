{
  "$defs": {
    "RatingEntry": {
      "additionalProperties": false,
      "description": "One rating change. A player's rating at time t is 6.0 plus the sum of their deltas up to t.",
      "properties": {
        "id": {
          "pattern": "^r_\\d{4,}$",
          "title": "Id",
          "type": "string"
        },
        "t": {
          "maximum": 5400,
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "player": {
          "pattern": "^[a-z]{3}_\\d{2}$",
          "title": "Player",
          "type": "string"
        },
        "event_id": {
          "pattern": "^e_\\d{4,}$",
          "title": "Event Id",
          "type": "string"
        },
        "raw_delta": {
          "title": "Raw Delta",
          "type": "number"
        },
        "scale": {
          "maximum": 1,
          "minimum": 0,
          "title": "Scale",
          "type": "number"
        },
        "delta": {
          "title": "Delta",
          "type": "number"
        },
        "rating_after": {
          "maximum": 9.9,
          "minimum": 3.1,
          "title": "Rating After",
          "type": "number"
        },
        "reason_code": {
          "minLength": 1,
          "title": "Reason Code",
          "type": "string"
        },
        "values": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Values",
          "type": "object"
        },
        "off_ball": {
          "title": "Off Ball",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "t",
        "player",
        "event_id",
        "raw_delta",
        "scale",
        "delta",
        "rating_after",
        "reason_code",
        "off_ball"
      ],
      "title": "RatingEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "start": {
      "default": 6.0,
      "title": "Start",
      "type": "number"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/RatingEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "entries"
  ],
  "title": "RatingsFile",
  "type": "object"
}
