{
  "$defs": {
    "Event": {
      "additionalProperties": false,
      "description": "One simulator event. ``from``/``to`` are Python keywords, so the attributes carry a trailing underscore.",
      "properties": {
        "id": {
          "pattern": "^e_\\d{4,}$",
          "title": "Id",
          "type": "string"
        },
        "t": {
          "maximum": 5400,
          "minimum": 0,
          "title": "T",
          "type": "number"
        },
        "type": {
          "enum": [
            "pass",
            "key_pass",
            "shot",
            "goal",
            "save",
            "tackle",
            "interception",
            "block",
            "clearance",
            "aerial_duel",
            "dribble",
            "foul",
            "handball",
            "offside",
            "card_yellow",
            "card_red",
            "pressure",
            "pressure_regain",
            "counterpress",
            "recovery_run",
            "marking_denial",
            "decoy_run",
            "shape_check",
            "error_leading_to_goal",
            "big_chance_missed",
            "injury",
            "gk_claim",
            "gk_sweep",
            "kickoff",
            "throw_in",
            "goal_kick",
            "corner",
            "free_kick",
            "penalty"
          ],
          "title": "Type",
          "type": "string"
        },
        "team": {
          "enum": [
            "azc",
            "rdm"
          ],
          "title": "Team",
          "type": "string"
        },
        "player": {
          "pattern": "^[a-z]{3}_\\d{2}$",
          "title": "Player",
          "type": "string"
        },
        "other": {
          "anyOf": [
            {
              "pattern": "^[a-z]{3}_\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Other"
        },
        "from": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "outcome": {
          "enum": [
            "success",
            "fail",
            "goal",
            "saved",
            "blocked",
            "off_target",
            "post",
            "awarded",
            "none"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "xg": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Xg"
        },
        "speed_kmh": {
          "anyOf": [
            {
              "maximum": 110,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Speed Kmh"
        },
        "importance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Importance",
          "type": "number"
        },
        "score": {
          "$ref": "#/$defs/Score"
        },
        "related": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Related"
        }
      },
      "required": [
        "id",
        "t",
        "type",
        "team",
        "player",
        "outcome",
        "importance",
        "score"
      ],
      "title": "Event",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A pitch point in meters (origin top-left).",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Point",
      "type": "object"
    },
    "Score": {
      "additionalProperties": false,
      "properties": {
        "azc": {
          "minimum": 0,
          "title": "Azc",
          "type": "integer"
        },
        "rdm": {
          "minimum": 0,
          "title": "Rdm",
          "type": "integer"
        }
      },
      "required": [
        "azc",
        "rdm"
      ],
      "title": "Score",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "match_id": {
      "title": "Match Id",
      "type": "string"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/Event"
      },
      "title": "Events",
      "type": "array"
    }
  },
  "required": [
    "match_id",
    "events"
  ],
  "title": "EventsFile",
  "type": "object"
}
